# Copie para .env.local (desenvolvimento, branch "dev" do Neon) e preencha.
# Nunca commite arquivos .env com valores reais. Guia completo: docs/BANCO.md

# Papel do APP (fuelift_app), com pooler (-pooler no host). Só SELECT/INSERT/UPDATE/DELETE.
DATABASE_URL=

# Papel DONO (neondb_owner), SEM pooler. Só para migrations, só na sua máquina.
# Não configurar no Vercel.
DATABASE_URL_MIGRACOES=

# Neon Auth: URL do console (Auth → Configuration) e segredo com 32+ caracteres.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Chave do HMAC-SHA256 da tabela limites (32+ caracteres). Diferente por ambiente.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LIMITES_HMAC_KEY=

# E-mails dos administradores (aprovam novos cadastros), separados por vírgula.
ADMIN_EMAILS=
