{
  "name": "fuelift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:banco": "node scripts/testar-banco.mjs",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "drizzle-kit migrate",
    "db:migrar:producao": "node scripts/migrar-producao.mjs",
    "taco:importar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/importar-taco.mjs",
    "ibge:importar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/importar-ibge.mjs",
    "exercicios:importar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/importar-exercicios.mjs"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
